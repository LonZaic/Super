# DeepSeek-Super 环境变量
# 复制此文件为 .env 并修改配置

# ══════════════════════════════════════
# 基础配置
# ══════════════════════════════════════

# 服务器端口
PORT=3001

# DeepSeek API Key（前端优先使用 localStorage 中的 key，此值作为后端默认值）
DEEPSEEK_API_KEY=sk-your-api-key-here

# 数据库路径（Docker 部署时使用 /app/data/deepseek-super.sqlite）
DB_PATH=./bbot.db

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# Agent 工作区根目录（默认用户主目录）
AGENT_WORKSPACE=

# 请求限流：每个 IP 每分钟最大请求数
RATE_LIMIT_MAX=100

# ══════════════════════════════════════
# Agent 引擎配置
# ══════════════════════════════════════

# 默认模型
DEFAULT_MODEL=deepseek-v4-pro

# 快速模型（用于摘要、压缩等轻量任务）
DEFAULT_FAST_MODEL=deepseek-v4-flash

# Agent 最大轮数（超过后自动压缩上下文）
MAX_ROUNDS_BEFORE_COMPACT=40

# Agent 超时时间（毫秒，默认 10 分钟）
AGENT_TIMEOUT_MS=600000

# 工具执行超时（毫秒）
TOOL_TIMEOUT_MS=30000

# ══════════════════════════════════════
# 接力模式 (Relay Mode)
# ══════════════════════════════════════

# 上下文窗口大小（Token 数，DeepSeek V4 = 1M）
RELAY_WINDOW_TOKENS=1000000

# 触发压缩的阈值（35% = 0.35）
RELAY_COMPACT_THRESHOLD=0.35

# 触发接力的阈值（45% = 0.45）
RELAY_THRESHOLD=0.45

# 压缩时保留的最近消息数
RELAY_MAX_RECENT_MESSAGES=30

# ══════════════════════════════════════
# Ambient 模式 (主动感知)
# ══════════════════════════════════════

# Ambient 检查间隔（分钟，0 = 禁用）
AMBIENT_CHECK_INTERVAL_MINUTES=30

# Ambient 检查回溯时间（分钟）
AMBIENT_SINCE_MINUTES=30

# ══════════════════════════════════════
# 并行编排 (Orchestrator)
# ══════════════════════════════════════

# 最大并行 Agent 数
ORCHESTRATOR_MAX_PARALLEL=5

# 子 Agent 最大工具调用轮数
ORCHESTRATOR_SUBAGENT_MAX_ROUNDS=3

# ══════════════════════════════════════
# 部署配置
# ══════════════════════════════════════

# 运行环境: development | production
NODE_ENV=development

# Docker 部署时数据持久化目录
# DATA_DIR=/app/data
# WORKSPACE_DIR=/app/workspace
